{
	"name": "dg/imap",
	"description": "📥 IMAP for PHP: the replacement for the imap extension that PHP 8.4 removed. Reads mailboxes, messages and attachments in pure PHP, with no dependencies.",
	"keywords": ["imap", "php-imap", "ext-imap", "email", "mailbox", "attachments"],
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": ">=8.1",
		"ext-iconv": "*",
		"ext-mbstring": "*",
		"ext-openssl": "*"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan": "^2.1@stable",
		"phpstan/extension-installer": "^1.4@stable",
		"nette/phpstan-rules": "^1.0"
	},
	"autoload": {
		"classmap": ["src/"]
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "2.0-dev"
		}
	}
}
